# Builds the React app, then serves it with Nginx, which also load-balances
# /api across the API server replicas (see deploy/nginx.conf)
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# The browser talks to the API through the same Nginx address
ENV VITE_API_URL=/api
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
